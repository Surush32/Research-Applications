# Supabase — copy to web/.env.local and fill in your project values
# Get these from: https://supabase.com/dashboard/project/_/settings/api
#
# Use ONLY the Project URL + anon/publishable key here.
# NEVER put the secret or service_role key in this file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
